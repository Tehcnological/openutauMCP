<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <OpenUtauDir Condition="'$(OpenUtauDir)' == ''">C:\Program Files\OpenUtau</OpenUtauDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="OpenUtau.Core"><HintPath>$(OpenUtauDir)\OpenUtau.Core.dll</HintPath></Reference>
    <Reference Include="YamlDotNet"><HintPath>$(OpenUtauDir)\YamlDotNet.dll</HintPath></Reference>
  </ItemGroup>
</Project>
